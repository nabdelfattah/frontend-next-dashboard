# Which environment the app talks to: local | development | staging | production
# Unset means "local" (mock data served from /api/<feature>).
# Base URLs per environment live in src/lib/app-config.ts.
#
# NEXT_PUBLIC_ vars are inlined at build time, so set this when running
# `next build` — changing it afterwards has no effect on an existing build.
NEXT_PUBLIC_APP_ENV=development
